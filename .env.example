# ==============================================================================
# AuraPDF Environment Configuration Template
# Contains variable NAMES only. NEVER commit real secrets or credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# Development: file:./dev.db
# Preview & Production: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Auth.js / NextAuth v5)
# Generate AUTH_SECRET via: openssl rand -base64 32
# ------------------------------------------------------------------------------
AUTH_SECRET=
NEXTAUTH_URL=

# Google OAuth 2.0 Credentials (From Google Cloud Console)
# Development Callback: http://localhost:3000/api/auth/callback/google
# Production Callback:  https://<your-production-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ------------------------------------------------------------------------------
# 3. PRIVATE OBJECT STORAGE (AWS S3, Cloudflare R2, or Supabase Storage)
# Development: Not required (defaults to local private storage: storage/uploads/)
# Production & Preview: Required for serverless PDF persistence
# ------------------------------------------------------------------------------
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE PROVIDERS
# Server-side only: keys are never exposed to browser clients
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. DEVELOPMENT / TEST PERSONA OVERRIDES (STRICTLY DEV ONLY)
# Must be omitted or set to 'false' in Preview & Production
# ------------------------------------------------------------------------------
ENABLE_DEV_AUTH=
NEXT_PUBLIC_ENABLE_DEV_AUTH=

# ------------------------------------------------------------------------------
# 6. APPLICATION METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_URL=
