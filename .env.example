# ==============================================================================
# AuraPDF Community Cloud Configuration Template
# Contains variable NAMES only. NEVER commit real secrets or credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE CONFIGURATION (PostgreSQL)
# Supabase Project Settings -> Database -> Connection string (URI)
# Production: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Local Dev fallback: file:./dev.db
# ------------------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# ------------------------------------------------------------------------------
# 2. SUPABASE PROJECT & CLOUD STORAGE (community-pdfs bucket)
# Supabase Project Settings -> API -> Project URL & Service Role / Anon Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=community-pdfs

# ------------------------------------------------------------------------------
# 3. STORAGE & UPLOAD LIMITS
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=100

# ------------------------------------------------------------------------------
# 4. OPTIONAL S3 / R2 STORAGE FALLBACK (If Supabase Storage is not used)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=supabase
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ------------------------------------------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE PROVIDERS
# Server-side only: keys are never exposed to browser clients
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 6. APPLICATION SECURITY & METADATA
# Generate AUTH_SECRET via: openssl rand -base64 32
# ------------------------------------------------------------------------------
AUTH_SECRET=
NEXT_PUBLIC_APP_NAME="AuraPDF Community Cloud"
NEXT_PUBLIC_APP_URL="https://aurapdf.study"
